				const presence = this.host.Owner.ReadTagPresence(wait.Tag);
				switch (presence.Kind) {
					case "Present":
						this.observedPresentTags.add(wait.Tag);
						return AwaitingEventPending;
					case "Absent": {
						if (this.observedPresentTags.has(wait.Tag)) {
							this.observedPresentTags.delete(wait.Tag);
							return { Kind: "WaitTriggered", Transition: wait.Transition };
						}
						return AwaitingEventPending;
					}
					default:
						return unreachable(presence);
				}
			}
